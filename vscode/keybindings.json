// toggle terminal and focue explorer
[
  {
    "key": "ctrl+e",
    "command": "-workbench.action.quickOpenNavigatePreviousInFilePicker",
    "when": "inFilesPicker && inQuickOpen",
  },
  {
    "key": "ctrl+shift+e",
    "command": "-workbench.action.quickOpenNavigatePreviousInFilePicker",
    "when": "inFilesPicker && inQuickOpen",
  },
  {
    "key": "ctrl+e",
    "command": "workbench.view.explorer",
    "when": "viewContainer.workbench.view.explorer.enabled",
  },
  {
    "key": "ctrl+shift+e",
    "command": "-workbench.view.explorer",
    "when": "viewContainer.workbench.view.explorer.enabled",
  },
  {
    "key": "ctrl+alt+c",
    "command": "workbench.action.terminal.openNativeConsole",
    "when": "!terminalFocus",
  },
  {
    "key": "ctrl+shift+c",
    "command": "-workbench.action.terminal.openNativeConsole",
    "when": "!terminalFocus",
  },
  {
    "key": "ctrl+alt+c",
    "command": "workbench.action.terminal.copySelection",
    "when": "terminalTextSelectedInFocused || terminalFocus && terminalHasBeenCreated && terminalTextSelected || terminalFocus && terminalProcessSupported && terminalTextSelected || terminalFocus && terminalTextSelected && terminalTextSelectedInFocused || terminalHasBeenCreated && terminalTextSelected && terminalTextSelectedInFocused || terminalProcessSupported && terminalTextSelected && terminalTextSelectedInFocused",
  },
  {
    "key": "ctrl+shift+c",
    "command": "-workbench.action.terminal.copySelection",
    "when": "terminalTextSelectedInFocused || terminalFocus && terminalHasBeenCreated && terminalTextSelected || terminalFocus && terminalProcessSupported && terminalTextSelected || terminalFocus && terminalTextSelected && terminalTextSelectedInFocused || terminalHasBeenCreated && terminalTextSelected && terminalTextSelectedInFocused || terminalProcessSupported && terminalTextSelected && terminalTextSelectedInFocused",
  },
  {
    "key": "ctrl+t",
    "command": "-vscode-neovim.send-cmdline",
    "when": "neovim.init && neovim.mode == 'cmdline'",
  },
  {
    "key": "ctrl+t",
    "command": "-vscode-neovim.send",
    "when": "editorTextFocus && neovim.ctrlKeysNormal.t && neovim.init && neovim.mode != 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'",
  },
  {
    "key": "ctrl+t",
    "command": "-vscode-neovim.send",
    "when": "editorTextFocus && neovim.ctrlKeysInsert.t && neovim.init && neovim.mode == 'insert' && editorLangId not in 'neovim.editorLangIdExclusions'",
  },
  {
    "key": "ctrl+t",
    "command": "-workbench.action.browser.newTab",
    "when": "activeEditor == 'workbench.editor.browser'",
  },
  {
    "key": "ctrl+t",
    "command": "-workbench.action.showAllSymbols",
  },
  {
    "key": "ctrl+t",
    "command": "workbench.action.terminal.toggleTerminal",
  },
  {
    "key": "ctrl+d",
    "command": "vscode-neovim.send",
    "args": "<C-d>",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+f",
    "command": "vscode-neovim.send",
    "args": "<C-f>",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+u",
    "command": "vscode-neovim.send",
    "args": "<C-u>",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+b",
    "command": "vscode-neovim.send",
    "args": "<C-b>",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.previousEditor",
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.nextEditor",
  },
  // lazygit
  {
    "key": "ctrl+g g",
    "command": "-lazygit.openLazygit",
  },
  {
    "key": "ctrl+g",
    "command": "-workbench.action.terminal.goToRecentDirectory",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported",
  },
  {
    "key": "ctrl+g",
    "command": "-workbench.action.gotoLine",
  },
  {
    "key": "ctrl+g",
    "command": "vscode-neovim.send",
    "args": "<C-g>",
    "when": "editorTextFocus",
  },
  // flash-vscode
  {
    "key": "escape",
    "command": "flash-vscode.exit",
    "when": "flash-vscode.active"
  },
  {
    "key": "backspace",
    "command": "flash-vscode.backspace",
    "when": "flash-vscode.active && editorTextFocus"
  },
  {
    "key": "ctrl+w e",
    "command": "workbench.action.closeOtherEditors",
    "when": "!editorTextFocus && !filesExplorerFocus && !searchViewletFocus && !terminalFocus && neovim.mode != 'cmdline'",
  },
  {
    "key": "ctrl+w r",
    "command": "workbench.action.reopenClosedEditor",
    "when": "!editorTextFocus && !filesExplorerFocus && !searchViewletFocus && !terminalFocus && neovim.mode != 'cmdline'",
  },
  {
    "key": "ctrl+w p",
    "command": "workbench.action.pinEditor",
    "when": "!editorTextFocus && !filesExplorerFocus && !searchViewletFocus && !terminalFocus && neovim.mode != 'cmdline'",
  }
]
